# Local Release Signing Configuration (Tauri)
# Nothing in this repo auto-loads .env — export these in your shell
# (or `set -a; source .env; set +a`) before running `npm run build:mac`.
# NEVER commit the real .env file.
#
# Note:
# - Tauri CLI reads the env vars below (not the Electron Builder CSC_* names).
# - GitHub Actions uses repository secrets with different names:
#   APPLE_CERTIFICATE <- MACOS_CERTIFICATE_P12_BASE64
#   APPLE_CERTIFICATE_PASSWORD <- MACOS_CERTIFICATE_PASSWORD
#   APPLE_PASSWORD <- APPLE_APP_SPECIFIC_PASSWORD
#   APPLE_TEAM_ID <- APPLE_TEAM_ID

# --- macOS code signing (either import path works) ---
# Path to your exported .p12 certificate and its password
APPLE_CERTIFICATE=""
APPLE_CERTIFICATE_PASSWORD=""

# Or the keychain identity name, if the cert is already in your keychain
# Find with: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"

# --- Notarization ---
# Apple ID for notarization
APPLE_ID="your-apple-id@example.com"

# App-specific password (Tauri reads APPLE_PASSWORD, not APPLE_APP_SPECIFIC_PASSWORD)
# Generate at: https://appleid.apple.com/account/manage
APPLE_PASSWORD=""

# Apple Developer Team ID
# Find at: https://developer.apple.com/account/#/membership
APPLE_TEAM_ID=""

# --- Updater artifact signing (minisign key from `tauri signer generate`) ---
TAURI_SIGNING_PRIVATE_KEY=""
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
